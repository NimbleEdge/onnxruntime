{
    "build_osx_archs": {
        "iphoneos": [
            "arm64"
        ],
        "iphonesimulator": [
            "arm64",
            "x86_64"
        ]
    },
    "build_params": {
        "base": [
            "--parallel",
            "--use_xcode",
            "--build_apple_framework",
            "--skip_tests",
            "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF",
            "--disable_rtti",
            "--enable_reduced_operator_type_support",
            "--build_shared_lib",
            "--minimal_build",
            "--disable_types sparsetensor float8 optional",
            "--enable_lto",
            "--cmake_extra_defines=onnxruntime_DISABLE_SPARSE_TENSORS =ON",
            "--cmake_extra_defines=onnxruntime_DISABLE_OPTIONAL_TYPE =ON",
            "--cmake_extra_defines=onnxruntime_DISABLE_FLOAT8_TYPES=ON",
            "--cmake_extra_defines=onnxruntime_ENABLE_CPUINFO=OFF"
        ],
        "macosx": [
            "--macos=MacOSX",
            "--apple_deploy_target=11.0"
        ],
        "iphoneos": [
            "--ios",
            "--apple_deploy_target=13.0"
        ],
        "iphonesimulator": [
            "--ios",
            "--apple_deploy_target=13.0"
        ]
    }
}
