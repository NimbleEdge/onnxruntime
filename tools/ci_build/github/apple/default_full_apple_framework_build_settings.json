{
    "build_osx_archs": {
        "iphoneos": [
            "arm64"
        ],
        "iphonesimulator": [
            "arm64",
            "x86_64"
        ]
    },
    "build_params": {
        "base": [
            "--parallel",
            "--use_xcode",
            "--build_apple_framework",
            "--skip_tests",
            "--cmake_extra_defines=onnxruntime_BUILD_UNIT_TESTS=OFF",
            "--disable_rtti",
            "--build_shared_lib",
            "--enable_lto"
        ],
        "macosx": [
            "--macos=MacOSX",
            "--apple_deploy_target=13.3"
        ],
        "iphoneos": [
            "--ios",
            "--apple_deploy_target=15.1"
        ],
        "iphonesimulator": [
            "--ios",
            "--apple_deploy_target=15.1"
        ]
    }
}
